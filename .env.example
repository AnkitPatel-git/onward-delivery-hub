# Copy to `.env` (or run `make env`). Only `VITE_*` keys are exposed to the browser.
# https://vitejs.dev/guide/env-and-mode.html

VITE_APP_NAME=SaiTrackSolutions
VITE_DEV_SERVER_PORT=3004

# Production API origin (no trailing slash). Local dev can leave this empty
# and use the Vite `/api` proxy below.
# VITE_API_BASE_URL=https://backend.portal.sbexpresscargo.com

# Dev/preview proxy to SB Express Cargo (not sent to the browser).
API_PROXY_TARGET=http://localhost:3001
# Must match backend WEBSITE_TRACKING_TOKENS. Used only by the Vite proxy.
WEBSITE_TRACKING_KEY=
